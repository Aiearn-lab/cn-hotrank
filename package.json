{
  "name": "cn-hotrank",
  "version": "0.1.0",
  "description": "中文社媒实时热榜 MCP server：今日头条/抖音/微博/百度热搜，结构化输出（排名/标题/热度值/标签/链接）",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cn-hotrank": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "deploy": "npm run build:worker && wrangler deploy",
    "deploy:dry": "npm run build:worker && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
